<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#2AF9D2AB"
                android:endColor="#00000000"
                android:gradientRadius="58dp"
                android:startColor="#66FFB06A"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="62dp"
        android:height="62dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#FF05080A"
                android:startColor="#FF17262A" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:width="50dp"
        android:height="50dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_screen_logo" />
    </item>
</layer-list>
