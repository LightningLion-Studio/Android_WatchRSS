<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".debug.DebugRssChallengeActivity"
            android:exported="true"
            android:theme="@style/Theme.WatchRSS.Translucent"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.lightningstudio.watchrss.action.DEBUG_RSS_CHALLENGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".debug.DebugNovelImportActivity"
            android:exported="true"
            android:theme="@style/Theme.WatchRSS.Translucent"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.lightningstudio.watchrss.action.DEBUG_IMPORT_TEN_PAGE_NOVEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
